cha. Una sola tienda: el stock de accesorios vive en productos.stock_actual y cada celular es una fila de equipos_imei." style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;fontColor=#475569;spacingLeft=12;spacingRight=12;" vertex="1" parent="leyenda"><mxGeometry y="472" width="470" height="88" as="geometry"/></mxCell><mxCell id="dominios" value="&lt;span style=&quot;font-size:10px;font-weight:normal;color:#475569&quot;&gt;«enumeration»&lt;/span&gt;&lt;br&gt;&lt;b&gt;Dominios (tipos ENUM de PostgreSQL)&lt;/b&gt;" style="swimlane;html=1;startSize=38;fillColor=#F1F5F9;strokeColor=#334155;swimlaneFillColor=#FFFFFF;fontSize=13;fontColor=#0F172A;rounded=0;collapsible=0;container=1;" vertex="1" parent="1"><mxGeometry x="2222" y="1926" width="806" height="422" as="geometry"/></mxCell><mxCell id="en-539" value="&lt;b&gt;accion_auditoria&lt;/b&gt; = { INSERT, UPDATE, DELETE }" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;spacingLeft=12;fontColor=#1E293B;" vertex="1" parent="dominios"><mxGeometry y="42" width="806" height="17" as="geometry"/></mxCell><mxCell id="en-540" value="&lt;b&gt;tipo_descuento&lt;/b&gt; = { PORCENTAJE, VALOR_FIJO }" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;spacingLeft=12;fontColor=#1E293B;" vertex="1" parent="dominios"><mxGeometry y="59" width="806" height="17" as="geometry"/></mxCell><mxCell id="en-541" value="&lt;b&gt;estado_orden_compra&lt;/b&gt; = { BORRADOR, ENVIADA, RECIBIDA_PARCIAL, RECIBIDA, ANULADA }" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;spacingLeft=12;fontColor=#1E293B;" vertex="1" parent="dominios"><mxGeometry y="76" width="806" height="17" as="geometry"/></mxCell><mxCell id="en-542" value="&lt;b&gt;estado_imei&lt;/b&gt; = { DISPONIBLE, APARTADO, VENDIDO, DEVUELTO, EN_SERVICIO, DADO_DE_BAJA }" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;spacingLeft=12;fontColor=#1E293B;" vertex="1" parent="dominios"><mxGeometry y="93" width="8